{
	"name": "pi-stuff",
	"version": "0.3.0",
	"description": "Personal Pi coding agent extensions.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"author": "Bogdan",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"extensions"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"check": "bun run lint && bun run typecheck && bun run test",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"pi": {
		"extensions": [
			"extensions/*.ts",
			"extensions/*/index.ts",
			"!extensions/ask/*.ts"
		],
		"prompts": [
			"prompts"
		],
		"themes": [
			"themes"
		],
		"skills": [
			"skills",
			"!skills/adversarial-qa",
			"!skills/agent-native-hardening",
			"!skills/chrome-cdp"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.99.2",
		"@earendil-works/pi-ai": ">=0.99.2",
		"@earendil-works/pi-coding-agent": ">=0.99.2",
		"@earendil-works/pi-tui": ">=0.99.2",
		"typebox": ">=1.3.34"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@earendil-works/pi-agent-core": "1.0.1",
		"@earendil-works/pi-ai": "1.0.1",
		"@earendil-works/pi-coding-agent": "1.0.1",
		"@earendil-works/pi-tui": "1.0.1",
		"@types/node": "^26.6.3",
		"@types/proper-lockfile": "^4.1.4",
		"typescript": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bogdan-d/pi-stuff.git"
	},
	"homepage": "https://github.com/bogdan-d/pi-stuff#readme",
	"bugs": {
		"url": "https://github.com/bogdan-d/pi-stuff/issues"
	},
	"dependencies": {
		"proper-lockfile": "^4.1.2"
	}
}
